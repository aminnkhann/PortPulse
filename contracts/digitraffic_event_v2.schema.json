{
  "additionalProperties": false,
  "description": "Normalized v2 event produced from a Digitraffic visit update.",
  "properties": {
    "event_id": {
      "minLength": 1,
      "title": "Event Id",
      "type": "string"
    },
    "port_call_id": {
      "minLength": 1,
      "title": "Port Call Id",
      "type": "string"
    },
    "event_time_utc": {
      "format": "date-time",
      "pattern": "Z$",
      "title": "Event Time Utc",
      "type": "string"
    },
    "received_at_utc": {
      "format": "date-time",
      "pattern": "Z$",
      "title": "Received At Utc",
      "type": "string"
    },
    "eta_utc": {
      "format": "date-time",
      "pattern": "Z$",
      "title": "Eta Utc",
      "type": "string"
    },
    "source_id": {
      "const": "digitraffic",
      "title": "Source Id",
      "type": "string"
    },
    "schema_version": {
      "const": "v2",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "port_call_id",
    "event_time_utc",
    "received_at_utc",
    "eta_utc",
    "source_id",
    "schema_version"
  ],
  "title": "PortPulse Digitraffic event v2",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portpulse.example/schemas/digitraffic_event_v2.schema.json"
}
